{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.linkedin-copilot.local/events/injection.completed.v1.schema.json",
  "title": "injection.completed v1",
  "description": "EVT-010. Extension confirms it wrote the approved text into the composer. Producer: extension. Drives T7 on result=injected with composer_text_hash == draft_hash (else SAFETY_VIOLATION). Injection is NOT sending (INV-013/INV-017).",
  "allOf": [
    { "$ref": "https://contracts.linkedin-copilot.local/envelope.schema.json" },
    {
      "type": "object",
      "properties": {
        "type": { "const": "injection.completed" },
        "event_version": { "const": 1 },
        "producer": { "const": "extension" },
        "data": { "$ref": "#/$defs/data" }
      },
      "required": ["causation_id", "thread_id", "message_id", "seq"]
    }
  ],
  "$defs": {
    "data": {
      "type": "object",
      "properties": {
        "draft_id": { "type": "string", "minLength": 1 },
        "consumed_jti": { "$ref": "https://contracts.linkedin-copilot.local/envelope.schema.json#/$defs/ulid" },
        "result": { "type": "string", "enum": ["injected", "refused", "dom_error"] },
        "composer_text_hash": { "$ref": "https://contracts.linkedin-copilot.local/envelope.schema.json#/$defs/sha256" },
        "injected_at": { "type": "string", "format": "date-time" },
        "refusal_reason": { "type": "string" }
      },
      "required": ["draft_id", "consumed_jti", "result", "composer_text_hash", "injected_at"],
      "allOf": [
        {
          "if": { "properties": { "result": { "enum": ["refused", "dom_error"] } } },
          "then": { "required": ["refusal_reason"] }
        }
      ],
      "additionalProperties": true
    }
  }
}
