{
  "manifest_version": 3,
  "name": "LinkedIn Copilot (observe + inject only)",
  "version": "0.1.0",
  "description": "Captures a LinkedIn thread, gets an AI draft via the local gateway, injects it into the composer on approval. NEVER sends. The human is the only sender.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "http://localhost:8080/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.linkedin.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
