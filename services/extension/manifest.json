{
  "manifest_version": 3,
  "name": "K70 AI Copilot (draft only)",
  "version": "0.2.0",
  "description": "Floating AI reply assistant for LinkedIn, WhatsApp Web and Instagram. Drafts only when you ask, inserts text after you approve. NEVER sends. The human is the only sender.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "http://localhost:8080/*"
  ],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": false
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.linkedin.com/*"
      ],
      "js": [
        "premium_panel.js",
        "content.js"
      ],
      "run_at": "document_idle",
      "css": [
        "premium_panel.css"
      ]
    },
    {
      "matches": ["https://web.whatsapp.com/*"],
      "js": ["adapter_common.js", "premium_panel.js", "whatsapp.js"],
      "css": ["premium_panel.css"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://www.instagram.com/*"],
      "js": ["adapter_common.js", "premium_panel.js", "instagram.js"],
      "css": ["premium_panel.css"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
