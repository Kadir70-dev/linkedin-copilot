# Public HTTPS entry point for the VPS (compose profile "vps").
# Caddy obtains and renews the TLS certificate for {$DOMAIN} automatically.
# Only the gateway is proxied; Redis and Ollama are never reachable from here.
# The gateway itself rejects every request without a valid access key.
{$DOMAIN} {
	encode gzip
	request_body {
		max_size 2MB
	}
	# Extension downloads (no secrets inside). Files use unguessable names;
	# no directory listing.
	# Mobile page (iPhone/Android): paste a message, get a draft, copy it.
	# Static, no secrets; the user's access key stays in their browser.
	redir /m /m/
	handle_path /m/* {
		root * /srv/m
		file_server
	}
	handle_path /dl/* {
		root * /srv/dl
		file_server
	}
	reverse_proxy gateway:8080 {
		header_up X-Real-IP {remote_host}
	}
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		-Server
	}
	log {
		output stdout
		format console
	}
}
