# Copy to .env:  cp .env.example .env
#
# ============================================================================
# LOW-RAM / HP EliteBook 840 G1 PRODUCTION PROFILE (2026-06-07)
# Target: Intel Haswell 2C/4T, 8GB RAM, CPU-only inference.
# Goal: STABILITY FIRST (no OOM, no crash), then speed.
# ============================================================================
#
# BASE model served by Ollama. This is the production default and the model used
# for general / recruiter / buyer / sourcing outreach + messaging replies.
# qwen2.5:3b loads in ~2.4GB and is ~1.4x faster than the 4B — the safe choice on 8GB.
MODEL=qwen2.5:3b
#
# PREMIUM model: used ONLY for high-value profiles (founder / CEO / director /
# owner / VP) via smart routing in the ai-brain, and ONLY when there is enough
# free RAM. Stronger grounding, near-zero hallucination. With
# OLLAMA_MAX_LOADED_MODELS=1, switching to this evicts the base model (and vice
# versa) so the box never holds two models at once. Under RAM pressure the brain
# automatically falls back to MODEL (base) — see PREMIUM_ROUTING / RAM_MIN_FREE_MB.
PREMIUM_MODEL=qwen3:4b-instruct-2507-q4_K_M
#
# Enable smart premium routing (premium profiles -> PREMIUM_MODEL). Set false to
# pin EVERYTHING to the base MODEL (most stable, lowest RAM, no model swapping).
PREMIUM_ROUTING=true
#
# ── ROLLBACK / ALTERNATES (uncomment, then `make restart`) ──
#MODEL=qwen3:4b-instruct-2507-q4_K_M  # use the 4B everywhere (heavier, ~3.4GB loaded)
#PREMIUM_MODEL=qwen3:8b               # 8B premium — INSTALLED but OFF by default; needs ~6GB+, risky on 8GB
#PREMIUM_ROUTING=false                # disable routing -> base model only (max stability)

# Low-resource CPU profile. TRUE on this hardware: best-of=1 + token caps +
# compact prompts + fast-path for every style except `founder` (best-of-2; forced
# to best-of-1 under RAM pressure). Pairs with the ollama NUM_PARALLEL=1 /
# MAX_LOADED_MODELS=1 / KEEP_ALIVE caps in docker-compose. Set false for full best-of-3.
FAST_MODE=true

# Strict one-profile-at-a-time generation (low-CPU stability). When true the
# ai-brain pulls and FULLY finishes a single profile (draft -> grounding ->
# review state) before starting the next — there are never two Ollama generations
# in flight. Default ON; FAST_MODE forces it on regardless. Set false ONLY on a
# GPU box where you want the worker to buffer multiple drafts.
SEQUENTIAL_MODE=true

# RAM safety threshold (MB of host MemAvailable). When free RAM drops below this,
# the ai-brain enters DEFENSIVE MODE: it forces the base model, disables premium
# routing, drops to best-of-1, unloads the premium model, and briefly pauses the
# queue between drafts — so it degrades gracefully instead of getting OOM-killed.
# Raise on a busier 8GB laptop (e.g. 1500).
RAM_MIN_FREE_MB=1200

# Vertical specialization of the outreach voice.
#   general  — founder-to-founder networking (default)
#   fashion  — B2B APPAREL / FASHION SOURCING (UAE/GCC manufacturing, garments,
#              textiles, private label, buyers, supply chain). Switches the
#              system prompt, style auto-detect (buyer/sourcing/merchandising ->
#              sourcing tier), and teaches the grounding gate the industry's
#              framing vocabulary (specific invented claims still rejected).
MODE=fashion

# Internal addresses (used by docker-compose services)
REDIS_ADDR=redis:6379
OLLAMA_BASE_URL=http://ollama:11434
GATEWAY_PORT=8080
DB_PATH=/data/app.db
