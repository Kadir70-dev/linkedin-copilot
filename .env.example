# Copy to .env:  cp .env.example .env
#
# ── MODEL STRATEGY (low-RAM-safe dual model, 2026-06-07) ──
# BASE model: production default, used for general/recruiter/buyer/sourcing
# outreach + messaging replies. qwen2.5:3b (~2.4GB loaded) is the stable choice
# on an 8GB CPU-only box (e.g. HP EliteBook 840 G1).
MODEL=qwen2.5:3b
#
# PREMIUM model: used ONLY for high-value profiles (founder/CEO/director/owner/VP)
# via smart routing in the ai-brain, and ONLY when free RAM allows. Stronger
# grounding. With OLLAMA_MAX_LOADED_MODELS=1 the box holds ONE model at a time;
# switching evicts the other. Under RAM pressure the brain auto-falls back to MODEL.
PREMIUM_MODEL=qwen3:4b-instruct-2507-q4_K_M
#
# Smart premium routing on/off. false = pin everything to base MODEL (max stability).
PREMIUM_ROUTING=true
#
# ── ROLLBACK / ALTERNATES (uncomment, then `make restart`) ──
#MODEL=qwen3:4b-instruct-2507-q4_K_M  # 4B everywhere (heavier, ~3.4GB loaded, ~1.4x slower)
#PREMIUM_MODEL=qwen3:8b               # 8B premium — INSTALLED but OFF; needs ~6GB+, risky on 8GB
#PREMIUM_ROUTING=false                # base model only

# Low-resource CPU profile. Set true on old CPU-only laptops: best-of=1 + token
# caps + compact prompts + fast-path for every style except `founder` (best-of-2).
# Pairs with ollama NUM_PARALLEL=1 / MAX_LOADED_MODELS=1 / KEEP_ALIVE in compose.
FAST_MODE=false

# Strict one-profile-at-a-time generation. true = the ai-brain finishes one
# profile (draft -> grounding -> review state) before starting the next; never two
# Ollama generations at once. Default ON (and FAST_MODE forces it). Set false only
# on a GPU box. Recommended scan limit in sequential mode: 1–2.
SEQUENTIAL_MODE=true

# RAM safety threshold (MB of host MemAvailable). Below this the ai-brain enters
# defensive mode (force base model, best-of-1, unload premium, pause queue) to
# avoid OOM. 0 disables the watchdog. ~1200 is sane for an 8GB box.
RAM_MIN_FREE_MB=1200

# Vertical outreach voice: general | fashion. "fashion" = B2B apparel/fashion
# SOURCING (UAE/GCC manufacturing, garments, textiles, private label, buyers,
# supply chain) — changes the system prompt, style detection, and grounding vocab.
MODE=general

# Internal addresses (used by docker-compose services)
REDIS_ADDR=redis:6379
OLLAMA_BASE_URL=http://ollama:11434
GATEWAY_PORT=8080
DB_PATH=/data/app.db
